{
  "name": "@switchbox/openfeature",
  "version": "0.7.0",
  "description": "OpenFeature web provider for Switchbox feature flags.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "openfeature",
    "openfeature-provider",
    "switchbox"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.9.0",
    "switchbox-js": ">=0.5.0"
  },
  "devDependencies": {
    "@openfeature/react-sdk": "^1.4.1",
    "@openfeature/web-sdk": "^1.9.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "switchbox-js": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
